<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="demo.mapper.CartMapper">

    <!-- 新增/累加数量 -->
    <insert id="insertOrUpdate">
        INSERT INTO cart(user_id,product_id,num)
        VALUES(#{userId},#{productId},1)
        ON DUPLICATE KEY UPDATE num = num + 1
    </insert>

    <!-- 定义Cart结果映射，嵌套Product -->
    <resultMap id="CartResultMap" type="demo.entity.Cart">
        <id column="c_id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="product_id" property="productId"/>
        <result column="num" property="num"/>
        <result column="create_time" property="createTime"/>
        <!-- 嵌套商品对象 -->
        <association property="product" javaType="demo.entity.Product">
            <id column="p_id" property="id"/>
            <result column="p_name" property="name"/>
            <result column="p_description" property="description"/>
            <result column="p_price" property="price"/>
            <result column="p_category" property="category"/>
            <result column="p_seller" property="seller"/>
            <result column="p_contact" property="contact"/>
            <result column="p_image" property="image"/>
        </association>
    </resultMap>

    <!-- 查询用户购物车+关联商品 -->
    <select id="selectByUserId" resultMap="CartResultMap">
        SELECT
        c.id c_id,
        c.user_id,
        c.product_id,
        c.num,
        c.create_time,
        p.id p_id,
        p.name p_name,
        p.description p_description,
        p.price p_price,
        p.category p_category,
        p.seller p_seller,
        p.contact p_contact,
        p.image p_image
        FROM cart c
        LEFT JOIN product p ON c.product_id = p.id
        WHERE c.user_id = #{userId}
        ORDER BY c.create_time DESC
    </select>

    <!-- 修改数量 -->
    <update id="updateNum">
        UPDATE cart SET num = #{num} WHERE id = #{id}
    </update>

    <!-- 删除单条 -->
    <delete id="deleteById">
        DELETE FROM cart WHERE id = #{id}
    </delete>

    <!-- 清空购物车 -->
    <delete id="deleteByUserId">
        DELETE FROM cart WHERE user_id = #{userId}
    </delete>
</mapper>